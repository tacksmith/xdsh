# XDSH public-install template. Keep the real file at ~/.xdsh/config/telegram.env.
# Replace placeholders and chmod 600; never commit the real file.
XDSH_TELEGRAM_BOT_TOKEN=replace-with-independent-bot-token
XDSH_TELEGRAM_ALLOWED_USERS=replace-with-numeric-user-id
XDSH_LITELLM_BASE_URL=http://127.0.0.1:4000
XDSH_LITELLM_API_KEY=replace-with-loopback-gateway-key
# Use the exact executable model ID in your own gateway.
XDSH_LITELLM_MODEL=replace-with-exact-model-id
XDSH_DEFAULT_LANGUAGE=en
# Edit one progress card once per second, including quiet model/tool periods.
# Network latency and Telegram retry_after can delay updates; no extra model calls.
XDSH_TELEGRAM_PROGRESS_INTERVAL_SECONDS=1
XDSH_TELEGRAM_PROGRESS_HEARTBEAT_SECONDS=1
XDSH_SETTINGS_PATH=~/.xdsh/config/settings.json
# Optional provider grouping; settings.json may add aliases omitted by
# LiteLLM /model/info. It never adds a route or stores credentials.
# XDSH_MODEL_PROVIDER_ALIASES=volc-coding=ark-code-latest;local-llama=qwen-local
# RC2: /absolute/path/to/node /path/to/dsh-sdk-jsonrpc-demo/lib/packaged-bin.js
XDSH_DSH_RUNTIME_COMMAND=replace-with-official-dsh-jsonrpc-command
# Optional official DSH CLI argv for approval-gated /plugins management.
# Alpha profile launchers derive `dsh` automatically; override when needed.
# XDSH_DSH_PLUGIN_COMMAND=dsh
XDSH_STATE_ROOT=~/.xdsh/telegram/state
XDSH_WORKSPACE_ROOT=~/.xdsh/telegram/workspaces
XDSH_DSH_HOME=~/.xdsh/telegram/state/dsh-home
XDSH_DSH_PROVIDER=litellm-anthropic
# One model step may issue up to four runtime-declared concurrency-safe reads.
# Writes, installs, state changes, and dependent operations remain serial.
XDSH_MAX_PARALLEL_TOOL_CALLS=4
XDSH_AUTO_COMPACT_ENABLED=1
XDSH_NATIVE_COMPACTION_ENABLED=1
XDSH_AUTO_COMPACT_THRESHOLD_RATIO=0.70
XDSH_AUTO_COMPACT_RETAIN_RATIO=0.16
# Optional hybrid semantic memory. Configure all four required values together;
# only an authenticated HTTP loopback endpoint is accepted.
# XDSH_EMBEDDING_ENDPOINT=http://127.0.0.1:8081/v1/embeddings
# XDSH_EMBEDDING_MODEL=local-embedding-model
# XDSH_EMBEDDING_DIMENSIONS=1024
# XDSH_EMBEDDING_CREDENTIAL_ENV=XDSH_EMBEDDING_TOKEN
# XDSH_EMBEDDING_TOKEN=replace-with-independent-loopback-token
# XDSH_EMBEDDING_TIMEOUT_SECONDS=10
# Active long-running tasks have no default wall-clock ceiling. A true absence
# of structured DSH activity still warns/stops before a dead run can linger.
# XDSH_GUARD_STALL_SECONDS=600
# XDSH_GUARD_MAX_RUNTIME_SECONDS=unlimited
# Stop repeated identical failing calls even when unrelated tools succeed.
# A successful identical call or a verified artifact starts a new failure epoch.
# XDSH_GUARD_MAX_REPEATED_TOOL_ERRORS=3
# Bounded upstream 429 protection (native DSH retryPolicy + XDSH route gate).
# XDSH_RATE_LIMIT_MAX_CONCURRENT_REQUESTS=2
# XDSH_RATE_LIMIT_MIN_INTERVAL_SECONDS=0.25
# XDSH_RATE_LIMIT_MAX_RETRIES=5
# XDSH_RATE_LIMIT_BASE_BACKOFF_SECONDS=5
# XDSH_RATE_LIMIT_MAX_BACKOFF_SECONDS=120
# XDSH_RATE_LIMIT_MAX_RETRY_AFTER_SECONDS=120
# XDSH_RATE_LIMIT_QUEUE_TIMEOUT_SECONDS=120
# XDSH_RATE_LIMIT_JITTER_RATIO=0.10
# XDSH_RATE_LIMIT_ALLOW_FALLBACK=0
